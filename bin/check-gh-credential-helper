#!/usr/bin/env bash

set -euo pipefail

# Keep $HOME literal because Git expands it when invoking the shell helper.
# shellcheck disable=SC2016
expected_helper='!MISE_EXEC_AUTO_INSTALL=0 $HOME/.local/bin/mise exec --quiet gh -- gh auth git-credential'

for host in github.com gist.github.com; do
  helpers=()
  while IFS= read -r helper; do
    helpers+=("$helper")
  done < <(git config --global --get-all "credential.https://$host.helper" || true)

  actual_helper=""
  if ((${#helpers[@]} > 0)); then
    actual_helper="${helpers[${#helpers[@]} - 1]}"
  fi

  if [ "$actual_helper" != "$expected_helper" ]; then
    echo "ERROR: Git credential helper for $host is not the managed stable resolver." >&2
    exit 1
  fi
done

mise_bin="${MISE_BIN:-$HOME/.local/bin/mise}"
installed_version="$(gh --version)"
installed_version="${installed_version%%$'\n'*}"
resolved_version="$(MISE_EXEC_AUTO_INSTALL=0 "$mise_bin" exec --quiet gh -- gh --version)"
resolved_version="${resolved_version%%$'\n'*}"

if [ "$resolved_version" != "$installed_version" ]; then
  echo "ERROR: mise does not resolve the newly installed gh version." >&2
  echo "Installed: $installed_version" >&2
  echo "Resolved:  $resolved_version" >&2
  exit 1
fi
