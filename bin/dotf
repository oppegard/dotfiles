#!/bin/bash

set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
    SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
    SOURCE_PATH="$(readlink "$SOURCE_PATH")"
    case "$SOURCE_PATH" in
        /*) ;;
        *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_PATH" ;;
    esac
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
DOTFILES_DIR="$(dirname "$SCRIPT_DIR")"
export DOTFILES_DIR
# shellcheck source=bin/lib/dotf-common.sh
source "$SCRIPT_DIR/lib/dotf-common.sh"
LOGS_DIR="$DOTFILES_DIR/logs"
LOG_RETENTION=30

rotate_logs() {
    local retention="${1:-$LOG_RETENTION}"
    local logs=()
    local log_file

    [ -d "$LOGS_DIR" ] || return 0

    while IFS= read -r log_file; do
        [ -n "$log_file" ] && logs+=("$log_file")
    done < <(find "$LOGS_DIR" -maxdepth 1 -type f -name 'dotf_*.log' | sort -r)

    local index
    for ((index = retention; index < ${#logs[@]}; index++)); do
        rm -f -- "${logs[$index]}"
    done
}

# Initialize logging - create logs directory and set up log file
init_logging() {
    mkdir -p "$LOGS_DIR"
    rotate_logs $((LOG_RETENTION - 1))
    # Generate timestamp for log filename
    LOG_TIMESTAMP=$(dotf_date '%Y-%m-%d_%H-%M-%S')
    LOG_FILE="$LOGS_DIR/dotf_${LOG_TIMESTAMP}.log"
    export LOG_FILE
    : > "$LOG_FILE"
}

cmd_run() {
    init_logging
    debug "Starting dotf run command"
    "$SCRIPT_DIR/bootstrap"
    ensure_homebrew_env
    ensure_mise_env
    verify_tools
    announce "Tool prerequisites installed"
    cat <<'EOF'

This subprocess cannot update your Terminal's environment. Run:

  eval "$(/opt/homebrew/bin/brew shellenv bash)"
  export PATH="$HOME/.local/bin:$PATH"
  export MISE_AUTO_ENV=true

Continue with BOOTSTRAP.md steps 7–10: select your profile, adopt private
history, configure Git identity, and prepare BetterDisplay.
Then run ./bin/setup.sh as described in Step 11.
EOF

    debug "Run complete"
}

cmd_help() {
    cat <<'EOF'
dotf - Dotfiles tool bootstrap

Usage: dotf <command>

Commands:
  run    Install missing Homebrew, Homebrew Bash, and mise; stop before setup
  help   Show this help (also --help or -h)
EOF
}

main() {
    rotate_logs

    if [ "$#" -ne 1 ]; then
        cmd_help >&2
        return 1
    fi

    case "$1" in
        run) cmd_run ;;
        help|--help|-h) cmd_help ;;
        *)
            printf 'Error: Unknown command "%s"\n' "$1" >&2
            cmd_help >&2
            return 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
