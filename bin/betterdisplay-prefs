#!/usr/bin/env bash

set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [ -L "$SOURCE_PATH" ]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  case "$SOURCE_PATH" in
    /*) ;;
    *) SOURCE_PATH="$SOURCE_DIR/$SOURCE_PATH" ;;
  esac
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
DOTFILES_DIR="$(dirname "$SCRIPT_DIR")"
PREFERENCES_DOMAIN="pro.betterdisplay.BetterDisplay"
PREFERENCES_PATH="$DOTFILES_DIR/mise-dots/macos/BetterDisplay.plist"
APPLICATION_PATH="/Applications/BetterDisplay.app"
MANAGED_KEYS=(
  "allowExternallyInduced@SyncConfiguration:mostAppropriateBrightness@DisplayGroup:-1001"
  "delta@SyncConfiguration:mostAppropriateBrightness@DisplayGroup:-1001"
  "enabled@SyncConfiguration:mostAppropriateBrightness@DisplayGroup:-1001"
  "syncConfigurationControlTargets@DisplayGroup:-1001"
  "syncEnabled@DisplayGroup:-1001"
)

usage() {
  echo "Usage: $(basename "$0") <check|export|import>" >&2
  exit 64
}

require_application() {
  if [ ! -d "$APPLICATION_PATH" ]; then
    echo "ERROR: BetterDisplay is not installed at $APPLICATION_PATH" >&2
    exit 1
  fi
}

require_snapshot() {
  if [ ! -f "$PREFERENCES_PATH" ]; then
    echo "ERROR: BetterDisplay sync profile not found: $PREFERENCES_PATH" >&2
    exit 1
  fi
}

export_preferences() {
  local destination="$1"

  defaults export "$PREFERENCES_DOMAIN" "$destination"
  plutil -convert xml1 "$destination"
}

copy_preference_key() {
  local destination="$1" source="$2" key="$3" value_path
  value_path="$(mktemp "${TMPDIR:-/tmp}/betterdisplay-preference-value.XXXXXX")"

  if ! plutil -extract "$key" xml1 -o "$value_path" "$source"; then
    rm -f "$value_path"
    echo "ERROR: BetterDisplay preference key is missing: $key" >&2
    return 1
  fi

  if plutil -type "$key" "$destination" >/dev/null 2>&1; then
    plutil -replace "$key" -xml "$(<"$value_path")" "$destination"
  else
    plutil -insert "$key" -xml "$(<"$value_path")" "$destination"
  fi

  rm -f "$value_path"
}

create_sync_profile() {
  local destination="$1" source="$2" key

  plutil -create xml1 "$destination"
  for key in "${MANAGED_KEYS[@]}"; do
    copy_preference_key "$destination" "$source" "$key"
  done
}

check_preferences() {
  local preferences_path profile_path
  preferences_path="$(mktemp "${TMPDIR:-/tmp}/betterdisplay-preferences.XXXXXX")"
  profile_path="$(mktemp "${TMPDIR:-/tmp}/betterdisplay-sync-profile.XXXXXX")"
  trap 'rm -f "$preferences_path" "$profile_path"' RETURN

  export_preferences "$preferences_path"
  create_sync_profile "$profile_path" "$preferences_path"

  if cmp -s "$profile_path" "$PREFERENCES_PATH"; then
    echo "BetterDisplay synchronization profile matches dotfiles."
    return 0
  fi

  echo "BetterDisplay synchronization profile differs from dotfiles:" >&2
  diff -u "$PREFERENCES_PATH" "$profile_path" || true
  return 1
}

export_sync_profile() {
  local preferences_path profile_path
  preferences_path="$(mktemp "${TMPDIR:-/tmp}/betterdisplay-preferences.XXXXXX")"
  profile_path="$(mktemp "${TMPDIR:-/tmp}/betterdisplay-sync-profile.XXXXXX")"
  trap 'rm -f "$preferences_path" "$profile_path"' RETURN

  export_preferences "$preferences_path"
  create_sync_profile "$profile_path" "$preferences_path"

  if [ -f "$PREFERENCES_PATH" ] && cmp -s "$profile_path" "$PREFERENCES_PATH"; then
    echo "BetterDisplay synchronization profile already matches dotfiles."
    return 0
  fi

  mv "$profile_path" "$PREFERENCES_PATH"
  echo "BetterDisplay synchronization profile exported; commit mise-dots/macos/BetterDisplay.plist."
}

quit_betterdisplay() {
  if ! pgrep -x BetterDisplay >/dev/null 2>&1; then
    return 0
  fi

  osascript -e 'tell application id "pro.betterdisplay.BetterDisplay" to quit'

  for _ in {1..50}; do
    if ! pgrep -x BetterDisplay >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done

  echo "ERROR: BetterDisplay did not quit within 5 seconds." >&2
  exit 1
}

import_sync_profile() {
  local backup_path preferences_path temporary_path
  temporary_path="$(mktemp "${TMPDIR:-/tmp}/BetterDisplay.before-import.XXXXXX")"
  backup_path="${temporary_path}.plist"
  mv "$temporary_path" "$backup_path"
  preferences_path="$(mktemp "${TMPDIR:-/tmp}/betterdisplay-preferences.XXXXXX")"
  trap 'rm -f "$preferences_path"' RETURN

  defaults export "$PREFERENCES_DOMAIN" "$backup_path"
  echo "Backed up current BetterDisplay preferences to $backup_path."

  quit_betterdisplay
  export_preferences "$preferences_path"
  for key in "${MANAGED_KEYS[@]}"; do
    copy_preference_key "$preferences_path" "$PREFERENCES_PATH" "$key"
  done
  defaults import "$PREFERENCES_DOMAIN" "$preferences_path"
  open "$APPLICATION_PATH"
  echo "Imported BetterDisplay synchronization profile from dotfiles."
}

case "${1:-}" in
  check)
    require_application
    require_snapshot
    check_preferences
    ;;
  export)
    require_application
    export_sync_profile
    ;;
  import)
    require_application
    require_snapshot
    import_sync_profile
    ;;
  *) usage ;;
esac
