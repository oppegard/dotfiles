#!/bin/bash

set -euo pipefail

BOOTSTRAP_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_ROOT="$(dirname "$BOOTSTRAP_DIR")"
# shellcheck source=bin/lib/dotf-common.sh
source "$BOOTSTRAP_DIR/lib/dotf-common.sh"

ensure_dotfiles_checkout() {
    local target="$HOME/.dotfiles"

    if [ "$DOTFILES_ROOT" = "$target" ] || [ -e "$target" ] || [ -L "$target" ]; then
        return
    fi

    ln -s "$DOTFILES_ROOT" "$target"
}

ensure_full_disk_access() {
    local preferences_file terminal_app
    preferences_file="$HOME/Library/Preferences/com.apple.universalaccess.plist"

    # Test FDA write access without changing the file.
    if [ -e "$preferences_file" ] &&
        (exec 3>>"$preferences_file") 2>/dev/null; then
        return
    fi

    case "${TERM_PROGRAM:-}" in
        Apple_Terminal) terminal_app="Terminal.app" ;;
        ghostty|Ghostty) terminal_app="Ghostty.app" ;;
        *) terminal_app="${TERM_PROGRAM:-the terminal app running this bootstrap}" ;;
    esac

    announce "Full Disk Access is required for $terminal_app"
    open "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles" \
        >/dev/null 2>&1 || true
    cat >&2 <<EOF
In System Settings > Privacy & Security > Full Disk Access:

  1. Add and enable $terminal_app.
  2. Quit $terminal_app completely and reopen it.
  3. Rerun ./bin/dotf run.

Bootstrap stopped because macOS applies Full Disk Access only to a new app process.
EOF
    return 1
}

bootstrap_homebrew() {
    local install_script
    if [ ! -x /opt/homebrew/bin/brew ]; then
        announce "Installing Homebrew"
        install_script="$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        /bin/bash -c "$install_script"
    fi
    ensure_homebrew_env
}

bootstrap_bash() {
    if [ ! -x /opt/homebrew/bin/bash ]; then
        announce "Installing Homebrew Bash"
        /opt/homebrew/bin/brew install bash
    fi
}

bootstrap_mise() {
    export PATH="$HOME/.local/bin:$PATH"
    if ! command -v mise >/dev/null 2>&1; then
        announce "Installing mise"
        curl -fsSL https://mise.run | sh
    fi
    ensure_mise_env
}

main() {
    if [ "$#" -ne 0 ]; then
        echo "Usage: bootstrap" >&2
        return 1
    fi
    ensure_dotfiles_checkout
    if [ "$(uname -s)" != Darwin ] || [ "$(uname -m)" != arm64 ]; then
        echo "Error: bootstrap requires Apple Silicon macOS (a native arm64 terminal)." >&2
        return 1
    fi
    ensure_full_disk_access
    bootstrap_homebrew
    bootstrap_bash
    bootstrap_mise
    verify_tools
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
