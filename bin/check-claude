#!/usr/bin/env bash

if (($# != 0)); then
	echo 'Usage: check-claude' >&2
	exit 2
fi

if reply=$(claude --print --safe-mode --tools '' \
	--strict-mcp-config --mcp-config '{"mcpServers":{}}' \
	--no-session-persistence --effort low --max-turns 1 \
	--output-format text --system-prompt 'Reply with exactly OK.' \
	'Reply with exactly OK.' </dev/null); then
	if [[ $reply == OK ]]; then
		echo 'Claude is ready.'
		exit 0
	fi
	echo 'Claude readiness check failed: expected OK.' >&2
else
	status=$?
	echo "Claude readiness check failed: claude exited with status $status." >&2
fi

if [[ -n $reply ]]; then
	printf '%s\n' "$reply" >&2
fi
exit 1
