#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

printf '%s\n' \
  'This migration is now part of migrate-mise-dots-to-files-home.' \
  'Delegating to the full source-layout migration wizard.' >&2

exec "$script_dir/migrate-mise-dots-to-files-home" "$@"
