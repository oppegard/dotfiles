#!/usr/bin/env bash
#
# A wizard — walks a human through a manual procedure step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library — delightful, consistent UX. Identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear — wipe the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" — opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later — it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" — clear the screen, then announce a stage and show progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." — a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." — a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL — open in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser — visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser — visit it manually: $url"
}

# pause "msg" — wait for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" — y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY — current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" — read a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" — like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE — upsert KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE — set a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name — gh not ready; set it later"
}

# set_var NAME VALUE — set a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name — gh not ready; set it later"
}

# finish — clear, then a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES — author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=4
umask 077

preview_only=false
case "${1:-}" in
  '') ;;
  --dry-run) preview_only=true ;;
  -h|--help)
    printf 'Usage: %s [--dry-run]\n' "${0##*/}"
    exit 0
    ;;
  *)
    printf 'Usage: %s [--dry-run]\n' "${0##*/}" >&2
    exit 2
    ;;
esac
if (( $# > 1 )); then
  printf 'Usage: %s [--dry-run]\n' "${0##*/}" >&2
  exit 2
fi

backup_dir=""
fail() {
  printf '%sERROR:%s %s\n' "$RED" "$RESET" "$1" >&2
  exit 1
}
report_backup_on_error() {
  local status=$?
  if (( status != 0 )) && [[ -n "$backup_dir" ]]; then
    printf 'Private recovery backup: %s\n' "$backup_dir" >&2
  fi
}
trap report_backup_on_error EXIT

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd -P)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" = /* ]] || script_path="$script_dir/$script_path"
done
repo_dir="$(cd -P "$(dirname "$script_path")/.." && pwd -P)"
source_dir="$repo_dir/mise-dots/config/git"
source_rel="mise-dots/config/git"
target_dir="$HOME/.config/git"

is_tracked() {
  git -C "$repo_dir" ls-files --error-unmatch -- "$source_rel/$1" >/dev/null 2>&1
}
check_conflict() {
  local destination="$target_dir/$1"
  if [[ "$target_state" == real_directory ]] &&
     { [[ -e "$destination" ]] || [[ -L "$destination" ]]; }; then
    fail "Machine-only file conflicts with live path: $destination"
  fi
}
collect_unmanaged() {
  local source_file rel
  while IFS= read -r -d '' source_file; do
    rel="${source_file#"$source_dir"/}"
    if ! is_tracked "$rel"; then
      check_conflict "$rel"
      printf '%s\0' "$rel"
    fi
  done
}
same_as_backup() {
  local rel="$1" current="$2" saved="$backup_dir/source/$1"
  if [[ -L "$saved" ]]; then
    [[ -L "$current" ]] &&
      [[ "$(readlink "$saved")" == "$(readlink "$current")" ]]
  else
    cmp -s "$saved" "$current"
  fi
}

stage "Check this machine and checkout"
say "This wizard migrates Git config after you pull the new mise mapping."
step "Check that mise, Git, the checkout, and ~/.dotfiles are in place."
command -v git >/dev/null || fail 'Git is required.'
command -v mise >/dev/null || fail 'mise is required.'
[[ -d "$source_dir" ]] || fail "Missing source directory: $source_dir"
[[ -d "$HOME/.dotfiles" ]] || fail "The $HOME/.dotfiles link must point to this checkout."
[[ "$(cd -P "$HOME/.dotfiles" && pwd -P)" == "$repo_dir" ]] ||
  fail "The $HOME/.dotfiles link points to a different checkout."

expected_mapping='"~/.config/git" = { source = "~/.dotfiles/mise-dots/config/git", mode = "symlink-each", manifest = "git" }'
grep -Fqx "$expected_mapping" "$repo_dir/mise/config.toml" ||
  fail 'Pull the per-file Git mapping before running this wizard.'

for runtime_file in local hooks/post-checkout hooks/post-commit hooks/post-merge hooks/pre-push; do
  if is_tracked "$runtime_file"; then
    fail "Machine-only file is in the Git index: $runtime_file"
  fi
done

if [[ -L "$target_dir" ]]; then
  resolved_target="$(cd -P "$target_dir" && pwd -P)" ||
    fail "The existing Git directory link is dangling: $target_dir"
  [[ "$resolved_target" == "$source_dir" ]] ||
    fail "Refusing to replace a link outside this checkout: $target_dir"
  target_state=old_link
elif [[ -d "$target_dir" ]]; then
  target_state=real_directory
elif [[ ! -e "$target_dir" ]]; then
  target_state=missing
else
  fail "Refusing to replace a non-directory: $target_dir"
fi

special_file="$(find "$source_dir" ! -type d ! -type f ! -type l -print -quit)"
[[ -z "$special_file" ]] || fail 'Source contains a special file; inspect it first.'

say "Checkout: $repo_dir"
say "Git directory: $target_dir ($target_state)"
say "Tracked files mise will link:"
git -C "$repo_dir" ls-files -z -- "$source_rel" |
  while IFS= read -r -d '' tracked_file; do
    say "  ${tracked_file#"$source_rel"/}"
  done
if ! "$preview_only"; then
  pause "Review this state, then press Enter to continue."
fi

stage "Inventory and private backup"
say "Only files outside Git's index will move to the real directory."
say "Machine-only files currently in the repository source:"
unmanaged_count=0
while IFS= read -r -d '' source_file; do
  rel="${source_file#"$source_dir"/}"
  if ! is_tracked "$rel"; then
    check_conflict "$rel"
    say "  $rel"
    unmanaged_count=$((unmanaged_count + 1))
  fi
done < <(find "$source_dir" \( -type f -o -type l \) -print0)
if (( unmanaged_count == 0 )); then
  note "No machine-only files found in the source."
fi

if "$preview_only"; then
  say "Would make a private backup under ${TMPDIR:-/tmp}."
else
  pause "Review these names, then press Enter to make the backup."
  backup_dir="$(mktemp -d "${TMPDIR:-/tmp}/mise-git-config.XXXXXXXX")"
  cp -Rp "$source_dir" "$backup_dir/source"
  find "$source_dir" \( -type f -o -type l \) -print0 > "$backup_dir/source-files"
  collect_unmanaged < "$backup_dir/source-files" > "$backup_dir/unmanaged-files"
  say "Private backup ready: $backup_dir"
  note "The backup stays available for recovery after the wizard finishes."
fi

stage "Confirm cutover and apply links"
if "$preview_only"; then
  say "Would replace only a verified Git directory link with a real directory."
  say "Would move $unmanaged_count machine-only file(s), then preview and apply"
  say "mise's Git-tracked per-file links without --force."
else
  step "Confirm before the directory link and machine-only files move."
  if ! confirm "Proceed with the Git config cutover?"; then
    say "Stopped without changing the Git directory."
    say "Private backup retained: $backup_dir"
    exit 0
  fi

  case "$target_state" in
    old_link)
      [[ -L "$target_dir" ]] &&
        [[ "$(cd -P "$target_dir" && pwd -P)" == "$source_dir" ]] ||
        fail 'The Git directory link changed since preflight.'
      ;;
    real_directory) [[ -d "$target_dir" && ! -L "$target_dir" ]] ||
        fail 'The real Git directory changed since preflight.' ;;
    missing) [[ ! -e "$target_dir" && ! -L "$target_dir" ]] ||
        fail 'A Git directory appeared since preflight.' ;;
  esac

  find "$source_dir" \( -type f -o -type l \) -print0 > "$backup_dir/current-source-files"
  cmp -s "$backup_dir/source-files" "$backup_dir/current-source-files" ||
    fail 'Source file names changed after backup; restart the wizard.'
  collect_unmanaged < "$backup_dir/current-source-files" > "$backup_dir/current-unmanaged-files"
  cmp -s "$backup_dir/unmanaged-files" "$backup_dir/current-unmanaged-files" ||
    fail 'Git index or machine-only files changed after backup; restart.'
  while IFS= read -r -d '' rel; do
    same_as_backup "$rel" "$source_dir/$rel" ||
      fail "Machine-only file changed after backup: $rel"
  done < "$backup_dir/unmanaged-files"

  if [[ "$target_state" == old_link ]]; then
    mv "$target_dir" "$backup_dir/previous-link"
  fi
  mkdir -p "$target_dir"
  while IFS= read -r -d '' rel; do
    source_file="$source_dir/$rel"
    destination="$target_dir/$rel"
    mkdir -p "$(dirname "$destination")"
    mv "$source_file" "$destination"
    same_as_backup "$rel" "$destination" ||
      fail "Moved file differs from private backup: $rel"
    say "Moved: $rel"
  done < "$backup_dir/unmanaged-files"

  step "Preview and apply only ~/.config/git with mise."
  mise -C "$repo_dir/mise" bootstrap dotfiles apply --dry-run "$target_dir"
  mise -C "$repo_dir/mise" bootstrap dotfiles apply --yes "$target_dir"
fi

stage "Verify Git paths and per-file links"
if "$preview_only"; then
  say "Would check the real directory, each tracked link, machine-only files,"
  say "mise status, and Git's include, excludes, and hook paths."
  say "Preview complete; no Git config files were changed."
  exit 0
fi

[[ -d "$target_dir" && ! -L "$target_dir" ]] ||
  fail 'The Git config directory is not real.'
mise -C "$repo_dir/mise" bootstrap dotfiles status --missing "$target_dir"

git -C "$repo_dir" ls-files -z -- "$source_rel" > "$backup_dir/tracked-files"
while IFS= read -r -d '' tracked_file; do
  rel="${tracked_file#"$source_rel"/}"
  destination="$target_dir/$rel"
  [[ -L "$destination" && "$destination" -ef "$source_dir/$rel" ]] ||
    fail "Managed file is not linked to its source: $rel"
  say "Linked: $rel"
done < "$backup_dir/tracked-files"
while IFS= read -r -d '' rel; do
  same_as_backup "$rel" "$target_dir/$rel" ||
    fail "Machine-only file differs from backup: $rel"
done < "$backup_dir/unmanaged-files"

check_git_path() {
  local key="$1" expected="$2" actual
  actual="$(git config --global --includes --path --get "$key" 2>/dev/null || true)"
  if [[ "$actual" == "$expected" ]]; then
    say "Git $key resolves to $expected"
  else
    warn "Git $key is '$actual'; expected '$expected'. Review your global Git config."
  fi
}
check_git_path include.path "$target_dir/local"
check_git_path core.excludesFile "$target_dir/ignore"
check_git_path core.hooksPath "$target_dir/hooks"

finish
say "Private backup retained: $backup_dir"
