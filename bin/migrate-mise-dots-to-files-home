#!/usr/bin/env bash
#
# A wizard — walks a human through a manual procedure step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library — delightful, consistent UX. Identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear — wipe the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" — opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later — it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" — clear the screen, then announce a stage and show progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." — a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." — a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL — open in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser — visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser — visit it manually: $url"
}

# pause "msg" — wait for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" — y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY — current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" — read a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" — like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE — upsert KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE — set a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name — gh not ready; set it later"
}

# set_var NAME VALUE — set a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name — gh not ready; set it later"
}

# finish — clear, then a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES — author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=5
umask 077

preview_only=false
case "${1:-}" in
  '') ;;
  --dry-run) preview_only=true ;;
  -h|--help)
    printf 'Usage: %s [--dry-run]\n' "${0##*/}"
    exit 0
    ;;
  *)
    printf 'Usage: %s [--dry-run]\n' "${0##*/}" >&2
    exit 2
    ;;
esac
if (( $# > 1 )); then
  printf 'Usage: %s [--dry-run]\n' "${0##*/}" >&2
  exit 2
fi

backup_dir=""
rollback_needed=false
platform=""
active_count=0
ACTIVE_TARGETS=()
home_marker='~'
git_target_label="$home_marker/.config/git"
bin_target_label="$home_marker/.local/bin"

fail() {
  printf '%sERROR:%s %s\n' "$RED" "$RESET" "$1" >&2
  exit 1
}

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd -P)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" = /* ]] || script_path="$script_dir/$script_path"
done
repo_dir="$(cd -P "$(dirname "$script_path")/.." && pwd -P)"
manifest="$repo_dir/mise/mise-dots-to-files-home.tsv"

expand_target() {
  case "$1" in
    "$home_marker") printf '%s' "$HOME" ;;
    "$home_marker"/*) printf '%s/%s' "$HOME" "${1#"$home_marker"/}" ;;
    *) fail "Target is not home-relative: $1" ;;
  esac
}

scope_is_active() {
  [[ "$1" == shared || "$1" == "$platform" ]]
}

mode_for() {
  if [[ "$platform" == macos ]]; then
    stat -f '%Lp' "$1"
  else
    stat -c '%a' "$1"
  fi
}

fingerprint_for() {
  if [[ -L "$1" ]]; then
    printf 'link:%s' "$(readlink "$1")"
  else
    cksum "$1" | awk '{print $1 ":" $2}'
  fi
}

link_points_to_old_tree() {
  local destination
  destination="$(readlink "$1")"
  case "$destination" in
    *'/mise-dots/'*|mise-dots/*) return 0 ;;
    *) return 1 ;;
  esac
}

link_is_expected_source() {
  local link_path="$1" old_source="$2" new_source="$3" destination
  destination="$(readlink "$link_path")"
  case "$destination" in
    "$old_source"|"$new_source"|*"/${old_source#"$repo_dir"/}"|*"/${new_source#"$repo_dir"/}") return 0 ;;
  esac
  if [[ -e "$link_path" && -e "$old_source" && "$link_path" -ef "$old_source" ]]; then
    return 0
  fi
  if [[ -e "$link_path" && -e "$new_source" && "$link_path" -ef "$new_source" ]]; then
    return 0
  fi
  return 1
}

assert_file_preserved() {
  local old_path="$1" new_path="$2"
  if [[ -L "$old_path" ]]; then
    [[ -L "$new_path" ]] || fail "Source type changed: $new_path"
    [[ "$(readlink "$old_path")" == "$(readlink "$new_path")" ]] ||
      fail "Source link changed: $new_path"
  else
    [[ -f "$new_path" && ! -L "$new_path" ]] || fail "Missing copied source: $new_path"
    cmp -s "$old_path" "$new_path" || fail "Copied source differs: $new_path"
  fi
  [[ "$(mode_for "$old_path")" == "$(mode_for "$new_path")" ]] ||
    fail "Source mode changed: $new_path"
}

assert_source_preserved() {
  local old_path="$1" new_path="$2" entry rel special
  [[ -e "$new_path" || -L "$new_path" ]] || fail "Missing new source: $new_path"
  if [[ ! -e "$old_path" && ! -L "$old_path" ]]; then
    return 0
  fi
  if [[ -d "$old_path" && ! -L "$old_path" ]]; then
    [[ -d "$new_path" && ! -L "$new_path" ]] || fail "Source type changed: $new_path"
    special="$(find "$old_path" ! -type d ! -type f ! -type l -print -quit)"
    [[ -z "$special" ]] || fail "Old source contains a special file: $special"
    while IFS= read -r -d '' entry; do
      rel="${entry#"$old_path"/}"
      assert_file_preserved "$entry" "$new_path/$rel"
    done < <(find "$old_path" \( -type f -o -type l \) -print0)
  else
    assert_file_preserved "$old_path" "$new_path"
  fi
}

config_for_scope() {
  case "$1" in
    shared) printf '%s/mise/config.toml' "$repo_dir" ;;
    macos) printf '%s/mise/config.macos.toml' "$repo_dir" ;;
    linux) printf '%s/mise/config.linux.toml' "$repo_dir" ;;
    *) fail "Unknown mapping scope: $1" ;;
  esac
}

assert_mapping() {
  local scope="$1" target="$2" new_rel="$3" mode="$4" config line
  config="$(config_for_scope "$scope")"
  line="$(grep -F "\"$target\" =" "$config" || true)"
  [[ -n "$line" ]] || fail "Missing mapping for $target in $config"
  case "$line" in
    *"~/.dotfiles/$new_rel"*) ;;
    *) fail "Mapping does not use the new source for $target" ;;
  esac
  case "$mode" in
    symlink)
      [[ "$line" == "\"$target\" = \"~/.dotfiles/$new_rel\"" ]] ||
        fail "Mapping mode changed for $target"
      ;;
    symlink-each|copy)
      [[ "$line" == *"mode = \"$mode\""* ]] ||
        fail "Mapping mode changed for $target"
      ;;
    *) fail "Unsupported manifest mode for $target: $mode" ;;
  esac
}

assert_support_consumers() {
  grep -Fq "PREFERENCES_PATH=\"\$DOTFILES_DIR/files/macos/BetterDisplay.plist\"" \
    "$repo_dir/bin/betterdisplay-prefs" ||
    fail 'BetterDisplay consumer does not use files/macos.'
  grep -Fq 'files/macos/unsupported-defaults.json' \
    "$repo_dir/mise/config.macos.toml" ||
    fail 'Unsupported-defaults consumer does not use files/macos.'
}

classify_target() {
  local target="$1" old_source="$2" new_source="$3" mode="$4"
  case "$mode" in
    symlink)
      if [[ -L "$target" ]]; then
        link_is_expected_source "$target" "$old_source" "$new_source" ||
          fail "Refusing unexpected link: $target -> $(readlink "$target")"
        printf 'link'
      elif [[ ! -e "$target" ]]; then
        printf 'missing'
      else
        fail "Refusing non-link target: $target"
      fi
      ;;
    symlink-each)
      if [[ -L "$target" ]]; then
        link_is_expected_source "$target" "$old_source" "$new_source" ||
          fail "Refusing unexpected directory link: $target -> $(readlink "$target")"
        printf 'legacy-directory-link'
      elif [[ -d "$target" ]]; then
        printf 'real-directory'
      elif [[ ! -e "$target" ]]; then
        printf 'missing'
      else
        fail "Refusing non-directory target: $target"
      fi
      ;;
    copy)
      if [[ -f "$target" && ! -L "$target" ]]; then
        printf 'copy'
      elif [[ ! -e "$target" && ! -L "$target" ]]; then
        printf 'missing'
      else
        fail "Refusing unexpected copy target: $target"
      fi
      ;;
    *) fail "Unsupported migration mode: $mode" ;;
  esac
}

target_is_nested_under_backup() {
  local rel="$1" state prior
  [[ -f "$backup_dir/backed-targets.tsv" ]] || return 1
  while IFS=$'\t' read -r state prior; do
    case "$rel/" in
      "$prior"/*) return 0 ;;
    esac
  done < "$backup_dir/backed-targets.tsv"
  return 1
}

backup_target() {
  local target="$1" rel state destination
  rel="${target#"$HOME"/}"
  target_is_nested_under_backup "$rel" && return 0
  if [[ -e "$target" || -L "$target" ]]; then
    state=present
    destination="$backup_dir/live/$rel"
    mkdir -p "$(dirname "$destination")"
    cp -pPR "$target" "$destination"
  else
    state=missing
  fi
  printf '%s\t%s\n' "$state" "$rel" >> "$backup_dir/backed-targets.tsv"
}

source_owns_rel() {
  local target_label="$1" old_rel="$2" new_rel="$3" rel="$4"
  if [[ "$target_label" == "$git_target_label" ]]; then
    git -C "$repo_dir" ls-files --error-unmatch -- "$old_rel/$rel" >/dev/null 2>&1 ||
      git -C "$repo_dir" ls-files --error-unmatch -- "$new_rel/$rel" >/dev/null 2>&1
  else
    [[ -e "$repo_dir/$new_rel/$rel" || -L "$repo_dir/$new_rel/$rel" ]]
  fi
}

collect_unmanaged() {
  local target_label="$1" target="$2" old_rel="$3" new_rel="$4"
  local entry rel kind fingerprint mode destination special
  [[ -e "$target" ]] || return 0
  special="$(find -H "$target" ! -type d ! -type f ! -type l -print -quit)"
  [[ -z "$special" ]] || fail "Live target contains a special file: $special"
  while IFS= read -r -d '' entry; do
    rel="${entry#"$target"/}"
    source_owns_rel "$target_label" "$old_rel" "$new_rel" "$rel" && continue
    case "$rel" in
      *$'\t'*|*$'\n'*) fail "Unsupported whitespace in live path: $entry" ;;
    esac
    if [[ -L "$entry" ]]; then kind="link"; else kind="file"; fi
    fingerprint="$(fingerprint_for "$entry")"
    mode="$(mode_for "$entry")"
    destination="$backup_dir/unmanaged/${target#"$HOME"/}/$rel"
    mkdir -p "$(dirname "$destination")"
    cp -pPR "$entry" "$destination"
    printf '%s\t%s\t%s\t%s\t%s\n' \
      "${target#"$HOME"/}" "$rel" "$kind" "$fingerprint" "$mode" \
      >> "$backup_dir/unmanaged.tsv"
  done < <(find -H "$target" \( -type f -o -type l \) -print0)
}

restore_unmanaged() {
  local target="$1" source
  source="$backup_dir/unmanaged/${target#"$HOME"/}"
  [[ -d "$source" ]] || return 0
  cp -pPR "$source/." "$target/"
}

rollback() {
  local state rel target failed saved
  set +e
  warn "Cutover failed; restoring the backed-up live targets."
  while IFS=$'\t' read -r state rel; do
    target="$HOME/$rel"
    if [[ -e "$target" || -L "$target" ]]; then
      failed="$backup_dir/failed-state/$rel"
      mkdir -p "$(dirname "$failed")"
      mv "$target" "$failed"
    fi
    if [[ "$state" == present ]]; then
      saved="$backup_dir/live/$rel"
      mkdir -p "$(dirname "$target")"
      cp -pPR "$saved" "$target"
    fi
  done < "$backup_dir/backed-targets.tsv"
  warn "Pre-cutover targets restored; failed state is retained in $backup_dir."
}

on_exit() {
  local status=$?
  if (( status != 0 )) && "$rollback_needed" && [[ -n "$backup_dir" ]]; then
    rollback
  fi
  if (( status != 0 )) && [[ -n "$backup_dir" ]]; then
    printf 'Private recovery backup: %s\n' "$backup_dir" >&2
  fi
  return "$status"
}
trap on_exit EXIT

prepare_symlink_each_target() {
  local target="$1" old_source="$2" new_source="$3" rel saved_link
  if [[ -L "$target" ]]; then
    link_is_expected_source "$target" "$old_source" "$new_source" ||
      fail "Directory link changed after backup: $target"
    rel="${target#"$HOME"/}"
    saved_link="$backup_dir/legacy-links/$rel"
    mkdir -p "$(dirname "$saved_link")"
    mv "$target" "$saved_link"
    mkdir -p "$target"
    restore_unmanaged "$target"
  elif [[ ! -e "$target" ]]; then
    mkdir -p "$target"
  elif [[ ! -d "$target" ]]; then
    fail "Symlink-each target changed after backup: $target"
  fi
}

record_old_links() {
  local target="$1" mode="$2" link
  if [[ "$mode" == symlink && -L "$target" ]]; then
    link_points_to_old_tree "$target" && printf '%s\n' "$target" >> "$backup_dir/remaining-old-links"
  elif [[ "$mode" == symlink-each && -d "$target" ]]; then
    while IFS= read -r -d '' link; do
      link_points_to_old_tree "$link" && printf '%s\n' "$link" >> "$backup_dir/remaining-old-links"
    done < <(find "$target" -type l -print0)
  fi
}

verify_unmanaged() {
  local target_rel rel kind expected mode path
  [[ -s "$backup_dir/unmanaged.tsv" ]] || return 0
  while IFS=$'\t' read -r target_rel rel kind expected mode; do
    path="$HOME/$target_rel/$rel"
    if [[ "$kind" == link ]]; then
      [[ -L "$path" ]] || fail "Machine-owned link was not preserved: $path"
    else
      [[ -f "$path" && ! -L "$path" ]] || fail "Machine-owned file changed type: $path"
    fi
    [[ "$(fingerprint_for "$path")" == "$expected" ]] ||
      fail "Machine-owned file changed: $path"
    [[ "$(mode_for "$path")" == "$mode" ]] || fail "Machine-owned mode changed: $path"
  done < "$backup_dir/unmanaged.tsv"
}

shared_bin_excludes() {
  case "$1" in
    fix-tahoe-focus|flush-dns|restart-soundsource|screen-5.0.1|try-darwin-aarch64|try-linux-x86_64) return 0 ;;
    *) return 1 ;;
  esac
}

verify_symlink_each() {
  local target_label="$1" target="$2" old_rel="$3" new_rel="$4"
  local source="$repo_dir/$new_rel" entry rel destination
  [[ -d "$target" && ! -L "$target" ]] || fail "Expected a real directory: $target"
  while IFS= read -r -d '' entry; do
    rel="${entry#"$source"/}"
    source_owns_rel "$target_label" "$old_rel" "$new_rel" "$rel" || continue
    if [[ "$target_label" == "$bin_target_label" ]] && shared_bin_excludes "$rel"; then
      continue
    fi
    destination="$target/$rel"
    [[ -L "$destination" && -e "$destination" && "$destination" -ef "$entry" ]] ||
      fail "Managed file is not linked to its new source: $destination"
  done < <(find "$source" \( -type f -o -type l \) -print0)
}

verify_target() {
  local target_label="$1" target="$2" old_rel="$3" new_rel="$4" mode="$5"
  local new_source="$repo_dir/$new_rel"
  case "$mode" in
    symlink)
      [[ -L "$target" && -e "$target" && "$target" -ef "$new_source" ]] ||
        fail "Target is not linked to its new source: $target"
      ;;
    symlink-each) verify_symlink_each "$target_label" "$target" "$old_rel" "$new_rel" ;;
    copy)
      [[ -f "$target" && ! -L "$target" ]] || fail "Copy target is missing: $target"
      cmp -s "$target" "$new_source" || fail "Copy target differs: $target"
      ;;
  esac
}

case "$(uname -s)" in
  Darwin) platform=macos ;;
  Linux) platform=linux ;;
  *) fail 'This migration supports macOS and Linux only.' ;;
esac

if "$preview_only"; then
  printf '\n%s%s  Migrate mise dotfile sources%s\n' "$BOLD" "$BLUE" "$RESET"
  note "Dry-run: no files or links will change."
else
  banner "Migrate mise dotfile sources"
fi

stage "Check this checkout and classify the machine"
command -v git >/dev/null || fail 'Git is required.'
command -v mise >/dev/null || fail 'mise is required.'
[[ -f "$manifest" ]] || fail "Missing migration manifest: $manifest"
[[ -d "$HOME/.dotfiles" ]] || fail "$HOME/.dotfiles must resolve to this checkout."
[[ "$(cd -P "$HOME/.dotfiles" && pwd -P)" == "$repo_dir" ]] ||
  fail "$HOME/.dotfiles points to a different checkout."

config_listing="$(mise -C "$repo_dir/mise" config ls)"
case "$config_listing" in
  *"config.$platform.toml"*) ;;
  *) fail "mise did not load config.$platform.toml" ;;
esac

say "Platform: $platform"
say "Checkout: $repo_dir"
while IFS=$'\t' read -r scope target old_rel new_rel mode; do
  [[ -z "$scope" || "$scope" == \#* ]] && continue
  assert_source_preserved "$repo_dir/$old_rel" "$repo_dir/$new_rel"
  [[ "$scope" == support ]] && continue
  assert_mapping "$scope" "$target" "$new_rel" "$mode"
  scope_is_active "$scope" || continue
  target_path="$(expand_target "$target")"
  state="$(classify_target "$target_path" "$repo_dir/$old_rel" "$repo_dir/$new_rel" "$mode")"
  say "$target ($state)"
  ACTIVE_TARGETS+=("$target_path")
  active_count=$((active_count + 1))
done < "$manifest"
assert_support_consumers

[[ "$active_count" -eq 30 ]] || fail "Expected 30 active mappings; found $active_count."
worktree_changes="$(git -C "$repo_dir" status --short -- mise files bin/migrate-mise-dots-to-files-home bin/migrate-git-config-to-file-links README.md 2>/dev/null || true)"
if [[ -n "$worktree_changes" ]]; then
  note "Migration-owned worktree changes are present; they will not be staged or altered."
fi
if ! "$preview_only"; then
  pause "Review this state, then press Enter to continue."
fi

stage "Inventory and make a private recovery backup"
if "$preview_only"; then
  say "Would back up all 30 active targets under ${TMPDIR:-/tmp}."
  say "Would inventory regular neighbours under Git, shell, and ~/.local/bin."
else
  pause "Press Enter to create the private backup."
  backup_dir="$(mktemp -d "${TMPDIR:-/tmp}/mise-files-home.XXXXXXXX")"
  : > "$backup_dir/backed-targets.tsv"
  : > "$backup_dir/unmanaged.tsv"
  while IFS=$'\t' read -r scope target old_rel new_rel mode; do
    [[ -z "$scope" || "$scope" == \#* || "$scope" == support ]] && continue
    scope_is_active "$scope" || continue
    target_path="$(expand_target "$target")"
    backup_target "$target_path"
    if [[ "$mode" == symlink-each ]]; then
      collect_unmanaged "$target" "$target_path" "$old_rel" "$new_rel"
    fi
  done < "$manifest"
  stale_sublime="$HOME/.config/sublime-text/Packages/User"
  if [[ "$platform" == macos && ( -e "$stale_sublime" || -L "$stale_sublime" ) ]]; then
    backup_target "$stale_sublime"
  fi
  say "Private backup ready: $backup_dir"
  unmanaged_count="$(wc -l < "$backup_dir/unmanaged.tsv" | tr -d ' ')"
  say "Machine-owned entries recorded: $unmanaged_count"
  note "The backup remains available after the wizard finishes."
fi

stage "Confirm and apply the new sources"
say "Affected mappings: $active_count"
say "mise will apply only the listed dotfile targets and will not use --force."
if "$preview_only"; then
  say "Would convert recognized legacy directory links, preview mise, then apply."
else
  if ! confirm "Proceed with the live source cutover?"; then
    say "Stopped before changing live targets."
    say "Private backup retained: $backup_dir"
    exit 0
  fi
  rollback_needed=true
  while IFS=$'\t' read -r scope target old_rel new_rel mode; do
    [[ -z "$scope" || "$scope" == \#* || "$scope" == support ]] && continue
    scope_is_active "$scope" || continue
    [[ "$mode" == symlink-each ]] || continue
    target_path="$(expand_target "$target")"
    prepare_symlink_each_target "$target_path" "$repo_dir/$old_rel" "$repo_dir/$new_rel"
  done < "$manifest"
  step "Preview the targeted mise apply."
  mise -C "$repo_dir/mise" bootstrap dotfiles apply --dry-run "${ACTIVE_TARGETS[@]}"
  step "Apply the new links and copy target."
  mise -C "$repo_dir/mise" bootstrap dotfiles apply --yes "${ACTIVE_TARGETS[@]}"
fi

stage "Reconcile known leftovers"
stale_sublime="$HOME/.config/sublime-text/Packages/User"
if "$preview_only"; then
  if [[ "$platform" == macos && -L "$stale_sublime" ]]; then
    say "Would move the stale macOS Sublime link into the private backup."
  else
    note "No known stale Sublime link needs cleanup on this platform."
  fi
  say "Would refuse any unrecognized link that still points into mise-dots."
else
  if [[ "$platform" == macos && -L "$stale_sublime" ]]; then
    old_sublime="$repo_dir/mise-dots/config/sublime-text/Packages/User"
    new_sublime="$repo_dir/files/home/.config/sublime-text/Packages/User"
    link_is_expected_source "$stale_sublime" "$old_sublime" "$new_sublime" ||
      fail "Refusing unexpected stale Sublime link: $stale_sublime"
    stale_backup="$backup_dir/stale-links/.config/sublime-text/Packages/User"
    mkdir -p "$(dirname "$stale_backup")"
    mv "$stale_sublime" "$stale_backup"
    rmdir "$HOME/.config/sublime-text/Packages" 2>/dev/null || true
    rmdir "$HOME/.config/sublime-text" 2>/dev/null || true
    say "Moved stale link into the private backup."
  fi

  : > "$backup_dir/remaining-old-links"
  while IFS=$'\t' read -r scope target old_rel new_rel mode; do
    [[ -z "$scope" || "$scope" == \#* || "$scope" == support ]] && continue
    scope_is_active "$scope" || continue
    record_old_links "$(expand_target "$target")" "$mode"
  done < "$manifest"
  if [[ -s "$backup_dir/remaining-old-links" ]]; then
    while IFS= read -r old_link; do warn "Still points into mise-dots: $old_link"; done < "$backup_dir/remaining-old-links"
    fail 'Unrecognized old-source links remain.'
  fi
fi

stage "Verify convergence"
if "$preview_only"; then
  say "Would require all $active_count mappings to be applied from files/home."
  say "Would compare machine-owned files with the backup and run a second dry-run."
  say "Dry-run complete; no live files or links changed."
  exit 0
fi

mise -C "$repo_dir/mise" bootstrap dotfiles status --missing "${ACTIVE_TARGETS[@]}"
while IFS=$'\t' read -r scope target old_rel new_rel mode; do
  [[ -z "$scope" || "$scope" == \#* || "$scope" == support ]] && continue
  scope_is_active "$scope" || continue
  verify_target "$target" "$(expand_target "$target")" "$old_rel" "$new_rel" "$mode"
done < "$manifest"
verify_unmanaged
[[ -f "$repo_dir/files/macos/BetterDisplay.plist" ]] || fail 'BetterDisplay profile is missing.'
[[ -f "$repo_dir/files/macos/unsupported-defaults.json" ]] || fail 'Unsupported-defaults manifest is missing.'
assert_support_consumers
mise -C "$repo_dir/mise" bootstrap dotfiles apply --dry-run "${ACTIVE_TARGETS[@]}"
rollback_needed=false

finish
say "Platform verified: $platform"
say "Mappings verified: $active_count"
say "Private backup retained: $backup_dir"
note "Keep the compatibility tree until every macOS and Linux host passes this wizard."
