#!/usr/bin/env bash

set -o pipefail

if ! accounts=$(op account list --format=json </dev/null | jq -er '
	arrays[] | (.user_uuid // .account_uuid)
	| if type == "string" and length > 0 and (contains("\n") | not)
	  then . else error("Invalid account ID") end
'); then
	echo 'Could not find 1Password accounts to check.' >&2
	exit 1
fi

checked_vault=false
while IFS= read -r account; do
	if ! vaults=$(op vault list --account "$account" --format=json </dev/null | jq -er '
		arrays | map(.id)
		| if all(.[]; type == "string" and length > 0 and (contains("\n") | not))
		  then join("\n") else error("Invalid vault ID") end
	'); then
		printf 'Could not list 1Password vaults for account %s.\n' "$account" >&2
		exit 1
	fi
	[[ -n $vaults ]] || continue
	while IFS= read -r vault; do
		if ! op item list --account "$account" --vault "$vault" </dev/null >/dev/null; then
			printf 'Could not access 1Password vault %s in account %s.\n' "$vault" "$account" >&2
			exit 1
		fi
		checked_vault=true
	done <<<"$vaults"
done <<<"$accounts"

if [[ $checked_vault == false ]]; then
	echo 'No 1Password vaults found to check.' >&2
	exit 1
fi

echo '1Password vaults are accessible.'
