amends "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.7.0/hk@2.7.0#/Builtins.pkl"

local bash_exclude = List("Alfred/**/**", "vendor/**/**")
steps {
  ["gitleaks"] = Builtins.gitleaks
  ["go_fmt"] = Builtins.go_fmt
  ["go_vet"] = Builtins.go_vet
  ["jactionlint"] = (Builtins.jactionlint) {
    diagnostic_format = "sarif"
    check = new CommandSpec {
      command = "jactionlint --format sarif {{ files }}"
      effect = "read"
    }
    check_diff = new CommandSpec {
      command = "hk util sarif-diff -- jactionlint --format sarif {{ files }}"
      effect = "read"
    }
    fix = new CommandSpec {
      command = "jactionlint --fix {{ files }}"
      effect = "write"
    }
  }
  ["mise"] = Builtins.mise
  ["newlines"] = (Builtins.newlines) {
    exclude = List("Alfred/**/**")
  }
  ["rumdl"] = Builtins.rumdl
  ["shellcheck"] = (Builtins.shellcheck) {
    exclude = bash_exclude
    check = new CommandSpec {
      command = "shellcheck -x {{ files }}"
      effect = "read"
    }
  }
  ["shfmt"] = (Builtins.shfmt) {
    exclude = bash_exclude
  }
  ["tombi"] = (Builtins.tombi_format) {
    exclude = List("**/Tuna/config.toml")
  }
  ["trailing_whitespace"] = (Builtins.trailing_whitespace) {
    exclude = List("files/home/.config/omarchy/branding/**/**")
  }
  ["yamlfmt"] = Builtins.yamlfmt
}
