amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

local secrets = new Step {
  check = new CommandSpec {
    command = new Command {
      argv = List("mise", "run", "lint:secrets")
    }
    effect = "read"
  }
}

hooks {
  ["check"] {
    fix = false
    stage = false
    stash = "none"
    steps {
      ["secrets"] = secrets
    }
  }
  ["pre-commit"] {
    fix = false
    stage = false
    stash = "none"
    steps {
      ["secrets"] = secrets
    }
  }
}
